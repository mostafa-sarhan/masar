# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it):
#   cp .env.prod.example .env.prod && ./deploy/setup.sh   (fills the secrets below)

# ---- Domains (same site, so auth cookies stay SameSite=Strict) ----
APP_DOMAIN=masar.mostafasarhan.tech
API_DOMAIN=api.masar.mostafasarhan.tech
LETSENCRYPT_EMAIL=

# ---- Secrets (deploy/setup.sh generates them) ----
JWT_SECRET=
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=masar
MONGO_APP_PASSWORD=

# ---- Ports on the server ----
# The app and API listen on 127.0.0.1 only; an existing reverse proxy can forward to them.
WEB_PORT=5081
API_PORT=5080
# Only with the bundled HTTPS proxy (COMPOSE_PROFILES=edge), which needs these free:
HTTP_PORT=80
HTTPS_PORT=443
# "edge" = run the bundled nginx + Let's Encrypt; leave empty if another proxy owns 80/443.
COMPOSE_PROFILES=edge

# Number of reverse proxies in front of the API (the edge proxy = 1).
TRUST_PROXY=1

# ---- Backups (./backups on the host) ----
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Hour of the daily backup, UTC (1 = 03:00 Cairo)
BACKUP_HOUR=1

# ---- Error monitoring (optional; empty = off) ----
SENTRY_DSN=
VITE_SENTRY_DSN=
# Origin of VITE_SENTRY_DSN, e.g. https://o123.ingest.sentry.io (allowed in the CSP)
SENTRY_ORIGIN=

# ---- Demo mode (a separate demo company, reset every hour) ----
DEMO_MODE=false
DEMO_TENANT_SLUG=demo
DEMO_TENANT_NAME=شركة مسار التجريبية
# WhatsApp number shown on the demo banner, international format without +, e.g. 201001234567
DEMO_WHATSAPP=
# Landing page "Try the live demo" button (the login page of a demo deployment)
VITE_DEMO_URL=

LOG_LEVEL=info
MONGO_CACHE_GB=0.5
