# Edge proxy: HTTPS for the app and the API (Let's Encrypt), HTTP → HTTPS.
# ${APP_DOMAIN} and ${API_DOMAIN} are filled by envsubst at container start.

server_tokens off;
client_max_body_size 3m;   # Excel imports are limited to 2 MB by the API

gzip on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_proxied any;
gzip_types application/json text/css application/javascript image/svg+xml;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream masar_web { server web:8080; keepalive 16; }
upstream masar_api { server api:5000; keepalive 32; }

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN} ${API_DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    location / {
        proxy_pass http://masar_web;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    location / {
        proxy_pass http://masar_api;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_read_timeout 60s;
    }
}
