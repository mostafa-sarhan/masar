# Settings of one Masar instance (docker-compose.prod.yml). deploy/setup.sh <name> creates
# .env.<name> from this file with fresh secrets; edit it there (chmod 600, never commit it).

COMPOSE_PROJECT_NAME=masar-prod
DOMAIN=masar.mostafasarhan.tech
# The web container listens on 127.0.0.1:WEB_PORT; host nginx proxies the domain to it.
WEB_PORT=8090

# ---- Secrets (generated by setup.sh) ----
JWT_SECRET=
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=masar
MONGO_APP_PASSWORD=
MONGO_KEYFILE=./deploy/secrets/prod/mongo-keyfile

# ---- Resources ----
MONGO_CACHE_GB=0.25

# ---- Backups (deploy/backup-now.sh, run daily by cron) ----
BACKUP_DIR=/var/backups/masar/prod
BACKUP_KEEP_DAYS=14

# ---- Demo mode (a demo company, reset every hour, one-click logins) ----
DEMO_MODE=false
DEMO_TENANT_SLUG=demo
DEMO_TENANT_NAME="شركة مسار التجريبية"
# WhatsApp number on the demo banner, digits only, e.g. 201001234567
DEMO_WHATSAPP=
# Landing page "Try the live demo" link (production points it at the demo site)
VITE_DEMO_URL=

# ---- Error monitoring (optional; empty = off) ----
SENTRY_DSN=
VITE_SENTRY_DSN=
# Origin of VITE_SENTRY_DSN, e.g. https://o123.ingest.sentry.io (allowed by the CSP)
SENTRY_ORIGIN=

LOG_LEVEL=info
